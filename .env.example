# Optional bounded selector. Deterministic evidence selection remains the default.
CODEBUDDY_ENABLED=false

# Optional per-engine overrides. If omitted, both inherit CODEBUDDY_ENABLED.
CODEBUDDY_QUESTION_SCAN_ENABLED=false
CODEBUDDY_RESEARCH_ENABLED=false

# In-process daily importer. Keep disabled unless explicitly operating a local demo.
QUESTION_CRON_ENABLED=false

# Weekly shadow research review. It creates suggestions only and never changes thresholds.
RESEARCH_CRON_ENABLED=false
