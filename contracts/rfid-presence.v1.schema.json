{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psychmap.rfid.presence.v1",
  "title": "Psych-MAP RFID presence session",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "tag_id", "scanner_id", "venue_id", "venue_label", "time_zone", "time_precision", "entered_at_utc", "entered_at_local_24h", "last_seen_at_utc", "last_seen_at_local_24h", "read_count", "status", "exit_inferred"],
  "properties": {
    "schema_version": { "const": "psychmap.rfid.presence.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": ["string", "null"] },
    "tag_id": { "type": "string", "minLength": 1 },
    "scanner_id": { "type": "string", "minLength": 1 },
    "venue_id": { "type": "string", "minLength": 1 },
    "venue_label": { "type": "string", "minLength": 1 },
    "time_zone": { "const": "Asia/Singapore" },
    "time_precision": { "const": "minute-floor" },
    "entered_at_utc": { "type": "string", "format": "date-time" },
    "entered_at_local_24h": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} ([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "last_seen_at_utc": { "type": "string", "format": "date-time" },
    "last_seen_at_local_24h": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} ([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "exited_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "exited_at_local_24h": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} ([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
    "duration_minutes_rounded": { "type": ["integer", "null"], "minimum": 0 },
    "read_count": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["active", "closed"] },
    "exit_inferred": { "type": "boolean" },
    "closed_reason": { "enum": ["signal_lost", "scanner_relocated", "service_stopped", null] }
  }
}
